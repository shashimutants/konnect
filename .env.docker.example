# ==============================================================================
# KONNECT MARKETING CMS - DOCKER CONTAINER ENVIRONMENT VARIABLES (.env.docker)
# ==============================================================================
# Copy this file to .env.docker or .env when deploying with Docker / Docker Compose:
#   cp .env.docker.example .env.docker
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM in Docker)
# ------------------------------------------------------------------------------
# Option A: SQLite (Default container volume path)
# Stores data in /app/prisma/dev.db (persisted across container restarts via docker volume)
DATABASE_URL="file:/app/prisma/dev.db"

# Option B: External / Compose PostgreSQL (Uncomment if using PostgreSQL database container)
# DATABASE_URL="postgresql://konnect_user:konnect_secure_password@postgres:5432/konnect_db?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# In Docker/Production, generate a secure random string:
#   openssl rand -base64 32
JWT_SECRET="replace_with_a_secure_random_64_char_secret_for_docker_production"

# ------------------------------------------------------------------------------
# 3. CACHE REVALIDATION & WEBHOOKS
# ------------------------------------------------------------------------------
# Secret token for authenticating external cache revalidation webhooks (/api/revalidate)
REVALIDATE_SECRET="replace_with_a_secure_revalidation_secret_for_docker"

# ------------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA ASSET STORAGE
# ------------------------------------------------------------------------------
# For Docker deployments, connecting Cloudinary is recommended for CDN delivery.
# If not configured, uploads are stored locally in /app/public/uploads (persisted via docker volume).
CLOUDINARY_CLOUD_NAME="your_production_cloud_name"
CLOUDINARY_API_KEY="your_production_api_key"
CLOUDINARY_API_SECRET="your_production_api_secret"
CLOUDINARY_UPLOAD_PRESET="konnect_preset"

# ------------------------------------------------------------------------------
# 5. PUBLIC SITE & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Set to your production domain or container ingress URL (e.g., https://yourdomain.com or http://localhost:3000)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Konnect Marketing USA"

# ------------------------------------------------------------------------------
# 6. CONTAINER RUNTIME SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"
