# ==============================================================================
# KONNECT MARKETING CMS - LOCAL DEVELOPMENT ENVIRONMENT VARIABLES (.env)
# ==============================================================================
# Copy this file to .env or .env.local for local machine development:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM)
# ------------------------------------------------------------------------------
# SQLite local file database path (default for local development)
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Secret key used for signing session JWTs and Draft Preview tokens
# Generate a random 64-character string for production: `openssl rand -base64 32`
JWT_SECRET="konnect_super_secret_jwt_key_2026_change_in_production"

# ------------------------------------------------------------------------------
# 3. CACHE REVALIDATION & WEBHOOKS
# ------------------------------------------------------------------------------
# Secret token for authenticating external cache revalidation webhooks (/api/revalidate)
REVALIDATE_SECRET="konnect_cache_revalidate_secret_2026"

# ------------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA ASSET STORAGE (Optional)
# ------------------------------------------------------------------------------
# If Cloudinary credentials are provided, uploads will automatically use Cloudinary.
# If left as placeholders or blank, the CMS automatically uses local disk storage (/public/uploads/).
# Cloudinary keys can also be configured dynamically in CMS Admin -> Global Settings.
CLOUDINARY_CLOUD_NAME="konnect-marketing"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_UPLOAD_PRESET="konnect_preset"

# ------------------------------------------------------------------------------
# 5. PUBLIC SITE & SEO CONFIGURATION
# ------------------------------------------------------------------------------
# Canonical base URL for SEO metadata, robots.txt, and sitemap.xml generation
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Konnect Marketing USA"

# ------------------------------------------------------------------------------
# 6. RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
